# Copy this file to .env and fill in real values locally. .env is git-ignored — never commit real values.

# --- WordPress ---
WP_ENV=development
WP_HOME=http://localhost
WP_SITEURL=${WP_HOME}/wp
WP_DEBUG=true

# --- Database ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# --- WP-CLI / REST API ---
WP_CLI_AVAILABLE=false
WP_APPLICATION_PASSWORD=

# --- ACF Pro ---
ACF_PRO_LICENSE_KEY=

# --- SMTP / Mail (fill in only if a form/mail plugin needs it) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Third-party services (only what Phase 07's plugin questionnaire actually approves) ---
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Deployment (Phase 20) ---
STAGING_URL=
PRODUCTION_URL=
DEPLOY_METHOD=
