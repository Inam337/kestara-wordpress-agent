{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(bash scripts/validation/check-required-docs.sh:*)",
      "Bash(bash scripts/deployment/deployment-checklist.sh:*)"
    ],
    "ask": [
      "Bash(bash scripts/setup/bootstrap-project.sh:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(wp-config.php)",
      "Read(wp-config-local.php)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-phase-status.sh"
          }
        ]
      }
    ]
  }
}
